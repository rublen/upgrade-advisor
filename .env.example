# ollama local embedding model
EMBEDDING_BASE_URL=http://localhost:11434/api
EMBEDDING_MODEL=nomic-embed-text:v1.5

# ollama local LLM
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_FALLBACK_MODEL=
LLM_API_KEY=ollama

# Groq (free plan, key from https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_...

# Run Solid Queue workers inside `bin/rails server` (otherwise run `bin/jobs`)
# Comment or remove to turn off Solid Queue, just setting to false won't work
SOLID_QUEUE_IN_PUMA=true
